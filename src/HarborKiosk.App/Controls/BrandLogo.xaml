<UserControl x:Class="HarborKiosk.App.Controls.BrandLogo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <StackPanel Orientation="Horizontal">
        <Grid Width="22" Height="24" VerticalAlignment="Center">
            <Path Stretch="Uniform" Data="M10,0 L19,5 L19,15 L10,20 L1,15 L1,5 Z"
                  Fill="{Binding Foreground, ElementName=Root}" />
            <Path Width="10" Height="8" Stretch="Uniform" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Data="M0,6 L5,11 L14,1" Stroke="{Binding CheckBrush, ElementName=Root}" />
        </Grid>
        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="17" FontWeight="Bold" Text="HARBOR" />
        <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" FontSize="17" Opacity="0.72" Text="BANK" />
    </StackPanel>
</UserControl>
