<UserControl x:Class="HarborKiosk.App.Controls.StepHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:HarborKiosk.App.Controls">
    <Border Background="#C8FFFFFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="24,18,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button Style="{StaticResource CircleButton}" HorizontalAlignment="Left"
                    AutomationProperties.Name="Back"
                    Command="{Binding GoBackCommand}"
                    Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}">
                <Path Style="{StaticResource ButtonIconPath}" Width="8" Height="14" Data="{StaticResource ChevronLeftGeometry}" />
            </Button>

            <ctl:BrandLogo VerticalAlignment="Center" Foreground="{StaticResource InkBrush}" CheckBrush="White">
                <ctl:BrandLogo.Style>
                    <Style TargetType="ctl:BrandLogo">
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CanGoBack}" Value="True">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ctl:BrandLogo.Style>
            </ctl:BrandLogo>

            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Margin="0,0,-10,0"
                    AutomationProperties.Name="Exit"
                    Command="{Binding ExitCommand}"
                    Visibility="{Binding CanExit, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Exit" FontWeight="Medium" VerticalAlignment="Center" />
                    <Path Style="{StaticResource ButtonIconPath}" Margin="10,0,0,0" Width="16" Height="16"
                          Data="{StaticResource ExitGeometry}" />
                </StackPanel>
            </Button>

            <Grid Grid.Row="1" Margin="0,14,0,8">
                <TextBlock Style="{StaticResource EyebrowText}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                           Text="{Binding FlowLabel}" />
                <TextBlock Style="{StaticResource EyebrowText}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Right" Text="{Binding StepText}" />
            </Grid>

            <Grid Grid.Row="2" Height="4">
                <Border Background="#E1E9E7" CornerRadius="2" />
                <Border Background="{StaticResource TealBrush}" CornerRadius="2" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding Progress}" />
                    </Border.RenderTransform>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
