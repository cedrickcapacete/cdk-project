<UserControl x:Class="HarborKiosk.App.Views.ThankYouView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:HarborKiosk.App.Controls">
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ReceiptPaper"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="170" To="0" Duration="0:0:1.4" BeginTime="0:0:0.2">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="TakeArrow"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="0" To="-5" Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Background="{StaticResource InkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="24,22,24,0" Height="48">
            <ctl:BrandLogo Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Margin="0,0,-10,0" Foreground="White"
                    AutomationProperties.Name="Exit" Command="{Binding DoneCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Exit" FontWeight="Medium" VerticalAlignment="Center" />
                    <Path Style="{StaticResource ButtonIconPath}" Margin="10,0,0,0" Width="16" Height="16"
                          Data="{StaticResource ExitGeometry}" />
                </StackPanel>
            </Button>
        </Grid>

        <DockPanel Grid.Row="1" Margin="32,36,32,22" LastChildFill="False">
            <StackPanel DockPanel.Dock="Top">
                <!-- Receipt emerging from the printer slot -->
                <Grid Width="250" Height="236">
                    <Grid Height="200" VerticalAlignment="Top" ClipToBounds="True">
                        <Border x:Name="ReceiptPaper" Width="176" Height="190" VerticalAlignment="Bottom" Background="White"
                                CornerRadius="3,3,0,0" Padding="18,22,18,0">
                            <Border.RenderTransform>
                                <TranslateTransform Y="170" />
                            </Border.RenderTransform>
                            <StackPanel>
                                <TextBlock HorizontalAlignment="Center" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource MutedBrush}" Text="DEPOSIT RECEIPT" />
                                <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="30" FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}" Text="{Binding AmountText}" />
                                <Border Height="1" Margin="0,16,0,0" Background="{StaticResource LineBrush}" />
                                <Border Height="1" Margin="0,10,40,0" Background="{StaticResource LineBrush}" />
                                <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" FontSize="9" FontFamily="Consolas"
                                           Foreground="{StaticResource MutedBrush}" Text="{Binding ReferenceText}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Height="44" VerticalAlignment="Bottom" CornerRadius="12" Background="{StaticResource InkDeepBrush}"
                            BorderBrush="#1E4A4C" BorderThickness="1">
                        <Border Height="6" Margin="22,0" VerticalAlignment="Top" CornerRadius="0,0,3,3" Background="#04100F" />
                    </Border>
                </Grid>

                <TextBlock Style="{StaticResource EyebrowText}" Margin="0,30,0,0" HorizontalAlignment="Center"
                           Foreground="{StaticResource LimeBrush}" Text="ALL DONE" />
                <TextBlock Style="{StaticResource HeadingText}" Margin="0,8,0,0" FontSize="44" Foreground="White" Text="Thank you" />
                <TextBlock Style="{StaticResource BodyText}" Margin="16,8,16,0" Foreground="#CCFFFFFF" Text="{Binding Message}" />

                <StackPanel Margin="0,22,0,0" Orientation="Horizontal" HorizontalAlignment="Center"
                            Visibility="{Binding IsReceiptReady, Converter={StaticResource BoolToVisibility}}">
                    <Path x:Name="TakeArrow" Style="{StaticResource IconPath}" Width="11" Height="15"
                          Stroke="{StaticResource LimeBrush}" Data="{StaticResource ArrowUpGeometry}">
                        <Path.RenderTransform>
                            <TranslateTransform />
                        </Path.RenderTransform>
                    </Path>
                    <TextBlock Margin="10,0,0,0" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource LimeBrush}"
                               Text="{Binding Prompt}" />
                </StackPanel>

                <Button Style="{StaticResource LimeButton}" Margin="0,30,0,0" FontSize="19" Content="Done"
                        Command="{Binding DoneCommand}" />
            </StackPanel>

            <TextBlock DockPanel.Dock="Bottom" HorizontalAlignment="Center" FontSize="13" Foreground="#99FFFFFF"
                       Text="Thank you for banking with Harbor Bank." />
        </DockPanel>
    </Grid>
</UserControl>
