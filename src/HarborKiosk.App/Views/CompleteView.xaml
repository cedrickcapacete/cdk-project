<UserControl x:Class="HarborKiosk.App.Views.CompleteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:HarborKiosk.App.Controls">
    <UserControl.Resources>
        <Style x:Key="SummaryLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SummaryValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SummaryRow" TargetType="Grid">
            <Setter Property="Height" Value="54" />
            <Setter Property="Margin" Value="18,0" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource ScreenBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ctl:StepHeader />

        <StackPanel Grid.Row="1" Margin="32,26,32,20">
            <Grid Width="104" Height="104">
                <Ellipse Fill="{StaticResource TealSoftBrush}" />
                <Ellipse Width="68" Height="68" Fill="{StaticResource TealBrush}" />
                <Path Style="{StaticResource IconPath}" Width="26" Height="20" Stroke="White" StrokeThickness="3.5"
                      HorizontalAlignment="Center" Data="{StaticResource CheckGeometry}" />
            </Grid>

            <TextBlock Style="{StaticResource EyebrowText}" Margin="0,18,0,0" HorizontalAlignment="Center" Text="DEPOSIT SUCCESSFUL" />
            <TextBlock Style="{StaticResource HeadingText}" Margin="0,8,0,0" Text="Transaction complete" />
            <TextBlock Style="{StaticResource BodyText}" Margin="12,6,12,0"
                       Text="Your cheque has been accepted and your deposit is being processed." />

            <Border Style="{StaticResource Card}" Margin="0,24,0,0">
                <StackPanel>
                    <Grid Style="{StaticResource SummaryRow}" Height="62">
                        <TextBlock Style="{StaticResource SummaryLabel}" Text="Deposit amount" />
                        <TextBlock Style="{StaticResource SummaryValue}" FontSize="26" Foreground="{StaticResource TealBrush}"
                                   Text="{Binding AmountText}" />
                    </Grid>
                    <Border Height="1" Margin="18,0" Background="{StaticResource LineBrush}" />
                    <Grid Style="{StaticResource SummaryRow}">
                        <TextBlock Style="{StaticResource SummaryLabel}" Text="To account" />
                        <TextBlock Style="{StaticResource SummaryValue}" Text="{Binding MaskedAccount}" />
                    </Grid>
                    <Border Height="1" Margin="18,0" Background="{StaticResource LineBrush}" />
                    <Grid Style="{StaticResource SummaryRow}">
                        <TextBlock Style="{StaticResource SummaryLabel}" Text="Date" />
                        <TextBlock Style="{StaticResource SummaryValue}" Text="{Binding DateText}" />
                    </Grid>
                    <Border Height="1" Margin="18,0" Background="{StaticResource LineBrush}" />
                    <Grid Style="{StaticResource SummaryRow}">
                        <TextBlock Style="{StaticResource SummaryLabel}" Text="Reference" />
                        <TextBlock Style="{StaticResource SummaryValue}" Text="{Binding Reference}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Margin="0,14,0,0" Padding="18,14" CornerRadius="12" Background="{StaticResource TealTintBrush}">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource IconPath}" Width="20" Height="20" Stroke="{StaticResource TealBrush}"
                          Data="{StaticResource ClockGeometry}" />
                    <StackPanel Margin="14,0,0,0">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="Funds availability" />
                        <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}" Text="{Binding FundsText}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button Style="{StaticResource PrimaryButton}" Margin="0,22,0,0" Command="{Binding GetReceiptCommand}"
                    AutomationProperties.Name="Get my receipt">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Get my receipt" />
                    <Path Style="{StaticResource ButtonIconPath}" Margin="14,0,0,0" Width="7" Height="12"
                          Data="{StaticResource ChevronRightGeometry}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
