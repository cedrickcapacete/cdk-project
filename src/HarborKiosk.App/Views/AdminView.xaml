<UserControl x:Class="HarborKiosk.App.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:HarborKiosk.App.Controls"
             xmlns:vm="clr-namespace:HarborKiosk.App.ViewModels">
    <UserControl.Resources>
        <Style x:Key="SegmentButton" TargetType="Button" BasedOn="{StaticResource KioskButtonBase}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource TealBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource EyebrowText}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style x:Key="StatTile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="5" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource ScreenBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ctl:StepHeader />

        <DockPanel Grid.Row="1" Margin="32,20,32,16">
            <!-- Title + period -->
            <Grid DockPanel.Dock="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource HeadingText}" HorizontalAlignment="Left" FontSize="28" Text="Kiosk admin" />
                    <TextBlock Margin="0,2,0,0" FontSize="14" Foreground="{StaticResource MutedBrush}" Text="{Binding PeriodText}" />
                </StackPanel>
                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,-10,0"
                        FontSize="14" Foreground="{StaticResource TealBrush}" Content="Refresh"
                        AutomationProperties.Name="Refresh" Command="{Binding RefreshCommand}" />
            </Grid>

            <Border DockPanel.Dock="Top" Margin="0,14,0,0" Padding="2" CornerRadius="14" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <UniformGrid Rows="1">
                    <Button Style="{StaticResource SegmentButton}" Content="Today" Tag="{Binding IsToday}"
                            Command="{Binding SelectPeriodCommand}" CommandParameter="{x:Static vm:ReportPeriod.Today}" />
                    <Button Style="{StaticResource SegmentButton}" Content="Last 7 days" Tag="{Binding IsLast7Days}"
                            Command="{Binding SelectPeriodCommand}" CommandParameter="{x:Static vm:ReportPeriod.Last7Days}" />
                    <Button Style="{StaticResource SegmentButton}" Content="Last 30 days" Tag="{Binding IsLast30Days}"
                            Command="{Binding SelectPeriodCommand}" CommandParameter="{x:Static vm:ReportPeriod.Last30Days}" />
                </UniformGrid>
            </Border>

            <!-- Summary tiles -->
            <Grid DockPanel.Dock="Top" Margin="-5,10,-5,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource StatTile}" Grid.ColumnSpan="2" Background="{StaticResource InkBrush}" BorderThickness="0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Foreground="{StaticResource LimeBrush}" Text="TOTAL DEPOSITED" />
                        <TextBlock Style="{StaticResource StatValue}" FontSize="30" Foreground="White" Text="{Binding TotalText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}" Grid.Column="2">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="CHEQUES" />
                        <TextBlock Style="{StaticResource StatValue}" FontSize="30" Text="{Binding CountText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}" Grid.Row="1">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="AVERAGE" />
                        <TextBlock Style="{StaticResource StatValue}" FontSize="18" Text="{Binding AverageText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}" Grid.Row="1" Grid.Column="1">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="PENDING" />
                        <TextBlock Style="{StaticResource StatValue}" FontSize="18" Text="{Binding PendingText}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatTile}" Grid.Row="1" Grid.Column="2">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StatLabel}" Text="RECEIPTS" />
                        <TextBlock Style="{StaticResource StatValue}" FontSize="18" Text="{Binding ReceiptsText}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Footer: actions + kiosk info -->
            <StackPanel DockPanel.Dock="Bottom">
                <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,8" FontSize="12" Foreground="{StaticResource TealBrush}"
                           Text="{Binding StatusMessage}"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}" />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,8" FontSize="12" Foreground="{StaticResource ErrorBrush}"
                           Text="{Binding PinWarning}"
                           Visibility="{Binding HasPinWarning, Converter={StaticResource BoolToVisibility}}" />

                <UniformGrid Rows="1" Margin="-5,0">
                    <Button Style="{StaticResource OutlineButton}" Margin="5,0" FontSize="16" Content="Export report"
                            AutomationProperties.Name="Export report" Command="{Binding ExportReportCommand}" />
                    <Button Style="{StaticResource PrimaryButton}" Height="60" Margin="5,0" FontSize="16" Content="Return to kiosk"
                            AutomationProperties.Name="Return to kiosk" Command="{Binding ReturnToKioskCommand}" />
                </UniformGrid>

                <Button Style="{StaticResource GhostButton}" Margin="0,8,0,0" HorizontalAlignment="Center"
                        Foreground="{StaticResource ErrorBrush}" FontSize="15"
                        AutomationProperties.Name="Close app" Command="{Binding CloseAppCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ButtonIconPath}" Width="16" Height="16" Data="{StaticResource ExitGeometry}" />
                        <TextBlock Margin="8,0,0,0" Text="{Binding CloseButtonText}" />
                    </StackPanel>
                </Button>

                <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource SubtleBrush}"
                           Text="{Binding KioskInfo}" />
            </StackPanel>

            <!-- Latest deposits across all accounts -->
            <Border Style="{StaticResource Card}" Margin="0,10,0,14" Padding="18,12,18,4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource StatLabel}" Text="LATEST DEPOSITS" />
                    <Grid>
                        <ItemsControl ItemsSource="{Binding RecentDeposits}"
                                      Visibility="{Binding HasRecentDeposits, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}">
                                                    <Run Text="{Binding Amount, Mode=OneWay}" />
                                                    <Run Text="  " />
                                                    <Run FontSize="12" FontWeight="Normal" Foreground="{StaticResource MutedBrush}"
                                                         Text="{Binding Account, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}">
                                                    <Run Text="{Binding When, Mode=OneWay}" />
                                                    <Run Text="  ·  " />
                                                    <Run FontFamily="Consolas" Text="{Binding Reference, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="9,4" CornerRadius="9"
                                                    Background="{StaticResource TealSoftBrush}">
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TealBrush}"
                                                           Text="{Binding Status}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,18" Text="No deposits recorded on this kiosk yet."
                                   Visibility="{Binding HasRecentDeposits, Converter={StaticResource InverseBoolToVisibility}}" />
                    </Grid>
                </DockPanel>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
