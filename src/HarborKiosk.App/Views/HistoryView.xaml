<UserControl x:Class="HarborKiosk.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:HarborKiosk.App.Controls">
    <Grid Background="{StaticResource ScreenBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ctl:StepHeader />

        <DockPanel Grid.Row="1" Margin="32,26,32,24">
            <StackPanel DockPanel.Dock="Top">
                <Border Style="{StaticResource IconBadge}">
                    <Path Style="{StaticResource IconPath}" Width="20" Height="20" Stroke="{StaticResource TealBrush}"
                          Data="{StaticResource HistoryGeometry}" />
                </Border>
                <TextBlock Style="{StaticResource HeadingText}" Margin="0,14,0,0" Text="Your recent deposits" />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" Text="{Binding AccountText}" />
            </StackPanel>

            <Button DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" Content="Done" Command="{Binding DoneCommand}" />

            <Grid Margin="0,22,0,18">
                <Border Style="{StaticResource Card}" VerticalAlignment="Top"
                        Visibility="{Binding HasDeposits, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Deposits}" Margin="18,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,14">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                                       Text="{Binding Amount}" />
                                            <TextBlock Margin="0,3,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}">
                                                <Run Text="{Binding Date, Mode=OneWay}" />
                                                <Run Text="  ·  " />
                                                <Run Text="{Binding Reference, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,5" CornerRadius="10"
                                                Background="{StaticResource TealSoftBrush}">
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TealBrush}"
                                                       Text="{Binding Status}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Border Style="{StaticResource Card}" VerticalAlignment="Top" Padding="24,32"
                        Visibility="{Binding HasDeposits, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Style="{StaticResource BodyText}" Text="No kiosk deposits yet. Deposits you make here will appear in this list." />
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
