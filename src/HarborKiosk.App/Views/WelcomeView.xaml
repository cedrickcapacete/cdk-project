<UserControl x:Class="HarborKiosk.App.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:HarborKiosk.App.Controls">
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="PulseDot" Storyboard.TargetProperty="Opacity"
                                     From="1" To="0.3" Duration="0:0:1" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid ClipToBounds="True">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
                <GradientStop Offset="0" Color="#2C6E68" />
                <GradientStop Offset="0.55" Color="#164A4A" />
                <GradientStop Offset="1" Color="#0B2427" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Decorative shapes shown behind (or instead of) the hero photo -->
        <Ellipse Width="520" Height="520" Margin="0,-140,-220,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Fill="#1AD9EC6E" />
        <Ellipse Width="360" Height="360" Margin="-160,170,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Fill="#145FC4B8" />

        <Image Source="{Binding HeroImage}" Stretch="UniformToFill"
               Visibility="{Binding HeroImage, Converter={StaticResource NullToCollapsed}}" />

        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#660B2427" />
                    <GradientStop Offset="0.35" Color="#000B2427" />
                    <GradientStop Offset="0.62" Color="#990B2427" />
                    <GradientStop Offset="1" Color="#F20B2427" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="32,30,32,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ctl:BrandLogo Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <!-- Staff entry: press and hold this badge for 3 seconds (or Ctrl+Shift+A). -->
            <Border x:Name="AdminHotspot" HorizontalAlignment="Right" Padding="14,8" CornerRadius="18" Background="#26FFFFFF"
                    BorderBrush="#40FFFFFF" BorderThickness="1"
                    PreviewMouseLeftButtonDown="OnHotspotDown" PreviewMouseLeftButtonUp="OnHotspotUp"
                    MouseLeave="OnHotspotUp" LostMouseCapture="OnHotspotUp">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource IconPath}" Width="11" Height="13" Stroke="White" StrokeThickness="1.6"
                          Data="{StaticResource LockGeometry}" />
                    <TextBlock Margin="8,0,0,0" FontSize="11" FontWeight="Bold" Foreground="White" Text="SECURE KIOSK" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2">
                <TextBlock Style="{StaticResource EyebrowText}" Foreground="{StaticResource LimeBrush}"
                           Text="BANKING THAT MOVES WITH YOU" />
                <TextBlock Margin="0,14,0,0" FontSize="54" FontWeight="Bold" Foreground="White" LineHeight="58"
                           LineStackingStrategy="BlockLineHeight" Text="More moments.&#x0a;Less waiting." />
                <TextBlock Margin="0,16,0,0" FontSize="18" Foreground="#E6FFFFFF" TextWrapping="Wrap" LineHeight="27"
                           Text="Deposit your cheque securely in just a few simple steps." />

                <Button Style="{StaticResource LimeButton}" Height="70" Margin="0,30,0,0" Padding="22,0,9,0"
                        HorizontalContentAlignment="Stretch" Command="{Binding StartDepositCommand}"
                        AutomationProperties.Name="Start a cheque deposit">
                    <Grid>
                        <TextBlock VerticalAlignment="Center" FontSize="19" FontWeight="Bold" Text="Start a cheque deposit" />
                        <Border Width="52" Height="52" HorizontalAlignment="Right" CornerRadius="10"
                                Background="{StaticResource InkBrush}">
                            <Path Style="{StaticResource IconPath}" Width="8" Height="14" Stroke="White"
                                  HorizontalAlignment="Center" Data="{StaticResource ChevronRightGeometry}" />
                        </Border>
                    </Grid>
                </Button>

                <StackPanel Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Grid Width="12" Height="12" VerticalAlignment="Center">
                        <Ellipse Fill="#40D9EC6E" />
                        <Ellipse x:Name="PulseDot" Width="6" Height="6" Fill="{StaticResource LimeBrush}" />
                    </Grid>
                    <TextBlock Margin="8,0,0,0" FontSize="14" Foreground="#CCFFFFFF" Text="Touch the screen to begin" />
                </StackPanel>

                <Button Style="{StaticResource GhostButton}" Margin="0,10,0,0" HorizontalAlignment="Center"
                        Foreground="#E6FFFFFF" FontSize="15" FontWeight="Medium" Command="{Binding ViewHistoryCommand}"
                        AutomationProperties.Name="View my recent deposits">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ButtonIconPath}" Width="15" Height="15" StrokeThickness="1.6"
                              Data="{StaticResource HistoryGeometry}" />
                        <TextBlock Margin="8,0,0,0" Text="View my recent deposits" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
