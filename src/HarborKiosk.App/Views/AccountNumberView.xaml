<UserControl x:Class="HarborKiosk.App.Views.AccountNumberView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:HarborKiosk.App.Controls">
    <Grid Background="{StaticResource ScreenBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ctl:StepHeader />

        <DockPanel Grid.Row="1" Margin="32,26,32,20" LastChildFill="False">
            <StackPanel DockPanel.Dock="Top">
                <Border Style="{StaticResource IconBadge}">
                    <Path Style="{StaticResource IconPath}" Width="20" Height="16" Stroke="{StaticResource TealBrush}"
                          Data="{StaticResource CardGeometry}" />
                </Border>
                <TextBlock Style="{StaticResource HeadingText}" Margin="0,14,0,0" Text="Enter your account number" />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" Text="{Binding Subtitle}" />

                <Border Style="{StaticResource EntryField}" Margin="0,22,0,0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource EyebrowText}" FontSize="11" HorizontalAlignment="Center"
                                       Text="ACCOUNT NUMBER" />
                            <Grid Height="46" Margin="0,4,0,0">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30"
                                           FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                           Text="{Binding DisplayText}"
                                           Visibility="{Binding HasDigits, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"
                                           Foreground="#C3D0CE" Text="●●●●   ●●●●   ●●●●"
                                           Visibility="{Binding HasDigits, Converter={StaticResource InverseBoolToVisibility}}" />
                            </Grid>
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="11"
                                   Foreground="{StaticResource SubtleBrush}" Text="{Binding CounterText}" />
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" />

                <ctl:NumericKeypad Margin="-6,14,-6,0" />

                <Button Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" Command="{Binding ContinueCommand}"
                        AutomationProperties.Name="Continue">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Continue" />
                        <Path Style="{StaticResource ButtonIconPath}" Margin="14,0,0,0" Width="7" Height="12"
                              Data="{StaticResource ChevronRightGeometry}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center">
                <Path Style="{StaticResource IconPath}" Width="11" Height="13" StrokeThickness="1.6"
                      Stroke="{StaticResource SubtleBrush}" Data="{StaticResource LockGeometry}" />
                <TextBlock Margin="8,0,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}"
                           Text="Your information is encrypted and secure" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
