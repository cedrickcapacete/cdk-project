<UserControl x:Class="HarborKiosk.App.Views.AdminPinView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:HarborKiosk.App.Controls">
    <Grid Background="{StaticResource ScreenBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ctl:StepHeader />

        <DockPanel Grid.Row="1" Margin="32,26,32,20" LastChildFill="False">
            <StackPanel DockPanel.Dock="Top">
                <Border Style="{StaticResource IconBadge}">
                    <Path Style="{StaticResource IconPath}" Width="14" Height="16" Stroke="{StaticResource TealBrush}"
                          Data="{StaticResource LockGeometry}" />
                </Border>
                <TextBlock Style="{StaticResource HeadingText}" Margin="0,14,0,0" Text="Staff sign-in" />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" Text="Enter the admin PIN to manage this kiosk." />

                <Border Style="{StaticResource EntryField}" Margin="0,22,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" FontSize="11" HorizontalAlignment="Center" Text="ADMIN PIN" />
                        <Grid Height="46" Margin="0,4,0,0">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22"
                                       Foreground="{StaticResource TextBrush}" Text="{Binding MaskedPin}"
                                       Visibility="{Binding HasDigits, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"
                                       Foreground="#C3D0CE" Text="4–8 digits"
                                       Visibility="{Binding HasDigits, Converter={StaticResource InverseBoolToVisibility}}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" />

                <ctl:NumericKeypad Margin="-6,14,-6,0" />

                <Button Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" Command="{Binding UnlockCommand}"
                        AutomationProperties.Name="Unlock">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Unlock" />
                        <Path Style="{StaticResource ButtonIconPath}" Margin="14,0,0,0" Width="7" Height="12"
                              Data="{StaticResource ChevronRightGeometry}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock DockPanel.Dock="Bottom" HorizontalAlignment="Center" FontSize="13" Foreground="{StaticResource MutedBrush}"
                       Text="For authorised Harbor Bank staff only" />
        </DockPanel>
    </Grid>
</UserControl>
