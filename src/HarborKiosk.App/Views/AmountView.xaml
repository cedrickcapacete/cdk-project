<UserControl x:Class="HarborKiosk.App.Views.AmountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:HarborKiosk.App.Controls">
    <Grid Background="{StaticResource ScreenBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ctl:StepHeader />

        <DockPanel Grid.Row="1" Margin="32,26,32,20" LastChildFill="False">
            <StackPanel DockPanel.Dock="Top">
                <Border Style="{StaticResource IconBadge}">
                    <Border Width="26" Height="26" CornerRadius="13" BorderThickness="2" BorderBrush="{StaticResource TealBrush}">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" FontSize="15"
                                   FontWeight="Bold" Foreground="{StaticResource TealBrush}" Text="$" />
                    </Border>
                </Border>
                <TextBlock Style="{StaticResource HeadingText}" Margin="0,14,0,0" Text="Enter the cheque amount" />
                <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" Text="Enter the exact amount written on your cheque." />

                <Border Style="{StaticResource EntryField}" Margin="0,22,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" FontSize="11" HorizontalAlignment="Center"
                                   Text="DEPOSIT AMOUNT" />
                        <StackPanel Margin="0,2,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Margin="0,8,4,0" VerticalAlignment="Top" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource TealBrush}" Text="$" />
                            <TextBlock FontSize="40" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                       Text="{Binding AmountText}" />
                            <TextBlock Margin="6,0,0,10" VerticalAlignment="Bottom" FontSize="11"
                                       Foreground="{StaticResource SubtleBrush}" Text="USD" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource SubtleBrush}" Text="{Binding LimitText}" />

                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" />

                <ctl:NumericKeypad Margin="-6,10,-6,0" />

                <Button Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" Command="{Binding ContinueCommand}"
                        AutomationProperties.Name="Continue">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Continue" />
                        <Path Style="{StaticResource ButtonIconPath}" Margin="14,0,0,0" Width="7" Height="12"
                              Data="{StaticResource ChevronRightGeometry}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
