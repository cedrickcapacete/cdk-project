<UserControl x:Class="HarborKiosk.App.Views.InsertChequeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:HarborKiosk.App.Controls">
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ChequeWrapper"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="0" To="16" Duration="0:0:1.1" AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="StatusDot" Storyboard.TargetProperty="Opacity"
                                     From="1" To="0.25" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Background="{StaticResource ScreenBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ctl:StepHeader />

        <StackPanel Grid.Row="1" Margin="32,22,32,20">
            <!-- Illustration: cheque sliding into the reader -->
            <Grid Height="200" Width="260">
                <Border x:Name="ChequeWrapper" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <Border.RenderTransform>
                        <TranslateTransform />
                    </Border.RenderTransform>
                    <Border Width="170" Height="82" CornerRadius="6" Background="White" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <RotateTransform Angle="-3" />
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.12" Direction="270" />
                        </Border.Effect>
                        <Grid Margin="12,10">
                            <TextBlock FontSize="7" FontWeight="Bold" Foreground="{StaticResource TealBrush}" Margin="0,10,0,0"
                                       Text="HARBOR BANK" />
                            <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" Text="{Binding AmountText}" />
                            <StackPanel VerticalAlignment="Bottom">
                                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,20,8" />
                                <Border Height="1" Background="{StaticResource LineBrush}" Width="70" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>

                <Path Style="{StaticResource IconPath}" Width="12" Height="16" Margin="0,104,0,0" VerticalAlignment="Top"
                      HorizontalAlignment="Center" Stroke="{StaticResource TealBrush}" Data="{StaticResource ArrowDownGeometry}" />

                <Border VerticalAlignment="Bottom" Height="70" Width="190" CornerRadius="14" Background="{StaticResource InkBrush}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.2" Direction="270" />
                    </Border.Effect>
                    <Grid>
                        <Border Height="5" Margin="26,18,26,0" VerticalAlignment="Top" CornerRadius="2.5" Background="{StaticResource InkDeepBrush}" />
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12,0,0" FontSize="8"
                                   FontWeight="Bold" Foreground="#80FFFFFF" Text="CHEQUE" />
                    </Grid>
                </Border>
            </Grid>

            <TextBlock Style="{StaticResource EyebrowText}" Margin="0,22,0,0" HorizontalAlignment="Center"
                       Text="{Binding StatusHeadline}" />
            <TextBlock Style="{StaticResource HeadingText}" Margin="0,8,0,0" Text="Insert your cheque" />
            <TextBlock Style="{StaticResource BodyText}" Margin="12,6,12,0"
                       Text="Place the cheque face up, with the top edge first. The kiosk will pull it in automatically." />

            <Border Style="{StaticResource Card}" Margin="0,22,0,0" Padding="18,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource TealSoftBrush}">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource TealBrush}" Text="1" />
                        </Border>
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="15" Foreground="{StaticResource TextBrush}"
                                   Text="Remove any staples or paper clips" />
                    </StackPanel>
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource TealSoftBrush}">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource TealBrush}" Text="2" />
                        </Border>
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="15" Foreground="{StaticResource TextBrush}"
                                   Text="Insert one cheque at a time" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button Style="{StaticResource OutlineButton}" Margin="0,20,0,0" Command="{Binding SimulateInsertCommand}"
                    AutomationProperties.Name="Simulate cheque inserted"
                    Visibility="{Binding CanSimulateInsert, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Simulate cheque inserted" />
                    <Path Style="{StaticResource ButtonIconPath}" Margin="14,0,0,0" Width="7" Height="12"
                          Data="{StaticResource ChevronRightGeometry}" />
                </StackPanel>
            </Button>

            <Button Style="{StaticResource PrimaryButton}" Margin="0,20,0,0" Command="{Binding RetryCommand}"
                    Visibility="{Binding HasFailed, Converter={StaticResource BoolToVisibility}}" Content="Try again" />

            <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="7" Height="7" VerticalAlignment="Center" Fill="{StaticResource TealBrush}" />
                <TextBlock Margin="8,0,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}" Text="{Binding StatusText}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
